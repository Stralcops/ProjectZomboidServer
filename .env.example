# URL complète du panel, protocole et port inclus.
# Local : http://localhost:8081 (80 est souvent déjà pris). OVH : https://zomboid.mondomaine.fr
APP_URL=http://localhost:8081
# Ports hôte du panel. Local : 8081/8443. OVH : 80/443 (nécessaire pour Let's Encrypt).
PANEL_HTTP_PORT=8081
PANEL_HTTPS_PORT=8443
# Local : true (Caddy sert tout nom d'hôte sur 80, Wings joint http://panel).
# OVH : false (Caddy sert le domaine de APP_URL en https avec Let's Encrypt).
BEHIND_PROXY=true
# Email pour Let's Encrypt (utilisé seulement si APP_URL est en https)
ADMIN_EMAIL=stralcops@gmail.com
TZ=Europe/Paris
